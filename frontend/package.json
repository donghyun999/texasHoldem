{
  "name": "texas-holdem-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "serve -s dist -l tcp://0.0.0.0:$PORT",
    "e2e": "node ../scripts/run-frontend-e2e.mjs",
    "e2e:headed": "node ../scripts/run-frontend-e2e.mjs --headed",
    "e2e:debug": "node ../scripts/run-frontend-e2e.mjs --debug",
    "e2e:playwright": "playwright test -c playwright.config.ts",
    "e2e:list": "playwright test -c playwright.config.ts --list"
  },
  "dependencies": {
    "@stomp/stompjs": "^7.2.0",
    "@tanstack/react-query": "^5.76.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.5.3",
    "serve": "^14.2.4",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.1.5",
    "@types/node": "^24.4.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.5",
    "typescript": "^5.8.3",
    "vite": "^7.1.4"
  }
}
